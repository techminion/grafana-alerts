# Generic single-rule Prometheus alert generated by `grafana-alerts create-alert`.
title: [[ group.name | tojson ]]
folderUid: [[ grafana.folder_uid | tojson ]]
interval: [[ group.evaluation_interval_seconds ]]
rules:
  - uid: [[ group.uid | tojson ]]
    title: [[ group.title | tojson ]]
    ruleGroup: [[ group.name | tojson ]]
    folderUID: [[ grafana.folder_uid | tojson ]]
    orgId: [[ grafana.org_id ]]
    condition: C
    data:
      - refId: A
        queryType: ""
        relativeTimeRange:
          from: [[ group.query_window_seconds ]]
          to: 0
        datasourceUid: [[ group.datasource_uid | tojson ]]
        model:
          datasource:
            type: prometheus
            uid: [[ group.datasource_uid | tojson ]]
          editorMode: code
          expr: [[ group.query | tojson ]]
          instant: false
          intervalMs: 1000
          legendFormat: __auto
          maxDataPoints: 43200
          range: true
          refId: A
      - refId: B
        queryType: ""
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          conditions: []
          datasource:
            type: __expr__
            uid: __expr__
          expression: A
          intervalMs: 1000
          maxDataPoints: 43200
          reducer: [[ group.reducer | tojson ]]
          refId: B
          type: reduce
      - refId: C
        queryType: ""
        relativeTimeRange:
          from: 0
          to: 0
        datasourceUid: __expr__
        model:
          conditions:
            - evaluator:
                params:
                  - [[ group.threshold ]]
                type: [[ group.evaluator | tojson ]]
              operator:
                type: and
              query:
                params:
                  - C
              reducer:
                params: []
                type: last
              type: query
          datasource:
            type: __expr__
            uid: __expr__
          expression: B
          intervalMs: 1000
          maxDataPoints: 43200
          refId: C
          type: threshold
    noDataState: [[ group.no_data_state | tojson ]]
    execErrState: [[ group.exec_error_state | tojson ]]
    for: [[ group.pending_for | tojson ]]
    annotations:
      summary: [[ group.summary | tojson ]]
      description: [[ group.description | tojson ]]
    labels:
{% for key, value in labels.items() %}
{% if key != "severity" %}
      [[ key ]]: [[ value | tojson ]]
{% endif %}
{% endfor %}
      severity: [[ group.severity | tojson ]]
    isPaused: false
