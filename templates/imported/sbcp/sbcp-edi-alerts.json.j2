{
  "title": [[ group.name | tojson ]],
  "folderUid": [[ grafana.folder_uid | tojson ]],
  "interval": 60,
  "rules": [
    {
      "uid": "aflprx2xteayob",
      "title": "[__SITE_NAME__][__ENVIRONMENT__] EDI-API overall p95 latency",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": [[ grafana.datasources.prometheus | tojson ]],
          "model": {
            "editorMode": "builder",
            "expr": "histogram_quantile(0.95, sum by(le, http_route, env, site_name) (rate(http_server_request_duration_seconds_bucket{site_name=\"__SITE_NAME__\", env=\"__ENVIRONMENT__\", http_route=~\"/zdc/tos-gateway/.*|/zodaic/edi/api/v1/transactions/submit|/zodiac/core/vessel-visit/edi-generate/.*|/zodiac/core/api/v1/docex/ops/data|/zodiac/ops/api/v1/equipments/with-doc|/zodiac/core/api/v1/docex/convert/submit|/zodiac/core/vessel-visit/edi-detail/message-recap.*|vessel-visit/edi-detail/stage-file/download\"}[5m])))",
            "hide": false,
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    10
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "5m",
      "annotations": {
        "description": "API Route: {{ $labels.http_route }}\nEnv: {{ $labels.env }}\nSite: {{ $labels.site_name }}\n\nLatency (P95):\n- Value: {{ $values.A.Value }} sec\n- Threshold: > 10 sec\n\nCalculation:\nhistogram_quantile(0.95, rate(http_server_request_duration_seconds_bucket[2m]))\n\nStatus:\nHigh latency detected for {{ $labels.http_route }}.\nCurrent value: {{ $values.A.Value }} (threshold: 10).",
        "summary": "High P95 latency detected for {{ $labels.http_route }} (P95={{ $values.A.Value }}s)"
      },
      "labels": {
        "env": "__ENVIRONMENT__",
        "og_priority": "P2",
        "ruleGroup": "__SITE_NAME__-EDI-Alerts",
        "site_name": "__SITE_NAME__",
        "team": "EDI"
      },
      "isPaused": false,
      "ruleGroup": [[ group.name | tojson ]],
      "folderUID": [[ grafana.folder_uid | tojson ]],
      "orgId": [[ grafana.org_id ]]
    },
