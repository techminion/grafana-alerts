{
  "title": [[ group.name | tojson ]],
  "folderUid": [[ grafana.folder_uid | tojson ]],
  "interval": 60,
  "rules": [
    {
      "uid": "ffpzkjyk2mjuoe",
      "title": "[__SITE_NAME__][__ENVIRONMENT__][AMQ] Queue Depth > 1000",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": [[ grafana.datasources.prometheus | tojson ]],
          "model": {
            "editorMode": "code",
            "exemplar": false,
            "expr": "sum by(destination, site_name, env)(\n  activemq_message_current_messages{\n    site_name=\"__SITE_NAME__\",\n    env=\"__ENVIRONMENT__\"\n  }\n)",
            "hide": false,
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    1000
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "10m",
      "annotations": {
        "description": "Queue {{ $labels.destination }} has {{ $value }} pending messages in {{ $labels.site_name }}/{{ $labels.env }}, exceeding threshold of 1000 for 10 minutes. Consumers may be slow, stalled, or disconnected.\n\nAction:\n1. Check active consumers on this queue in AMQ console\n2. Check consumer-side logs for errors or stalls\n3. Verify the consumer service is running\n4. If DLQ is growing alongside, check for poison-pill messages",
        "summary": "AMQ Queue Depth > 1000 — {{ $labels.destination }} ({{ $labels.site_name }}/{{ $labels.env }})"
      },
      "labels": {
        "og_priority": "P2",
        "product": "zodiac",
        "ruleGroup": "__SITE_NAME__-AMQ-Alerts",
        "severity": "warning",
        "site_name": "__SITE_NAME__"
      },
      "isPaused": false,
      "ruleGroup": [[ group.name | tojson ]],
      "folderUID": [[ grafana.folder_uid | tojson ]],
      "orgId": [[ grafana.org_id ]]
    },
