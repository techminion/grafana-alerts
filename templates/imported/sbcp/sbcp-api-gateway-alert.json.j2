            "editorMode": "code",
            "expr": "(\n  sum by (job, env, site_name,host_name) (jvm_memory_used_bytes{jvm_memory_type=\"heap\", site_name=\"__SITE_NAME__\", env=\"__ENVIRONMENT__\", job=~\"zara-api-gateway|zara-api-gateway-admin\"})\n  /\n  sum by (job, env, site_name,host_name) (jvm_memory_limit_bytes{jvm_memory_type=\"heap\", site_name=\"__SITE_NAME__\", env=\"__ENVIRONMENT__\", job=~\"zara-api-gateway|zara-api-gateway-admin\"})\n) * 100 > 95\n",
            "instant": true,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "range": false,
            "refId": "query"
          }
        },
        {
          "refId": "prometheus_math",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "-100",
          "model": {
            "datasource": {
              "IsPrunable": false,
