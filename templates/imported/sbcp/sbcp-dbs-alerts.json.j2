    {
      "uid": "ffm0dner7zz7kb",
      "title": "[__SITE_NAME__][__ENVIRONMENT__] DBS-API-Fast-Burn 5xx",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": [[ grafana.datasources.prometheus | tojson ]],
          "model": {
            "editorMode": "code",
            "expr": "sum by (job, http_route, env, site_name) (\n  rate(http_server_request_duration_seconds_count{\n    env=\"__ENVIRONMENT__\",\n    site_name=\"__SITE_NAME__\",\n    job=~\"zdc-microservice-dbs-api\",\n    http_response_status_code=~\"5..\"\n  }[5m])\n)",
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0.5
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "5m",
      "annotations": {
        "description": "API: {{ $labels.job }}\nEnv: {{ $labels.env }}\nSite: {{ $labels.site_name }}\n\n5xx Errors:\n- Error Rate (A): {{ $values.A.Value }} req/sec\n- Threshold: > 0.5 req/sec\n\nStatus:\n- Breach: {{ if gt $values.A.Value 0.5 }}true{{ else }}false{{ end }}",
        "summary": "Fast-burn 5xx spike detected for {{ $labels.job }} (A={{ $values.A.Value }})"
