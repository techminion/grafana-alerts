{
  "title": [[ group.name | tojson ]],
  "folderUid": [[ grafana.folder_uid | tojson ]],
  "interval": 60,
  "rules": [
    {
      "uid": "redis-sbcp-primary-count",
      "title": "[__SITE_NAME__][__ENVIRONMENT__][REDIS] Master count abnormal (no-master / split-brain)",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": [[ grafana.datasources.prometheus | tojson ]],
          "model": {
            "editorMode": "code",
            "expr": "count(max by (redis_hostname,redis_instance) (redis_role{site_name=\"__SITE_NAME__\",env=\"__ENVIRONMENT__\",role=\"primary\"})) or vector(0)",
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0.5,
                    1.5
                  ],
                  "type": "outside_range"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "for": "5m",
      "annotations": {
        "description": "Sentinel-managed HA group (5 instances, 1 expected master)\nEnv: {{ $labels.env }} | Site: {{ $labels.site_name }}\n\nDistinct masters in group: {{ $values.A.Value }}\nExpected: exactly 1\n\n0 = no master - cluster cannot accept writes (sentinel failover failed or in progress).\n2 = split-brain - two instances both believe they are master.\n\nCovers all 5 instances across both DCs (6680 on all four zap nodes + 6681 on p__SITE_NAME__vdc2zap01). The master may legitimately be any of them. Investigate sentinel state and replication topology immediately.",
        "summary": "Redis HA group master count abnormal (= {{ $values.A.Value }}, expected 1)"
      },
      "labels": {
        "ALERT_ON_SITE": "true",
        "env": "__ENVIRONMENT__",
        "og_priority": "P1",
        "product": "zodiac",
        "ruleGroup": "__SITE_NAME__-Redis-Alerts",
        "service": "redis",
        "severity": "critical",
        "site_name": "__SITE_NAME__"
      },
      "isPaused": false,
      "ruleGroup": [[ group.name | tojson ]],
      "folderUID": [[ grafana.folder_uid | tojson ]],
      "orgId": [[ grafana.org_id ]]
    },
    {
      "uid": "redis-sbcp-replica-drop",
      "title": "[__SITE_NAME__][__ENVIRONMENT__][REDIS] Replica count dropped",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": [[ grafana.datasources.prometheus | tojson ]],
          "model": {
            "editorMode": "code",
            "expr": "min by (redis_hostname,redis_instance,site_name,env) (redis_slaves_connected{site_name=\"__SITE_NAME__\",env=\"__ENVIRONMENT__\"} and on(redis_hostname,redis_instance) (max by (redis_hostname,redis_instance) (redis_role{role=\"primary\"})))",
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    4
                  ],
                  "type": "lt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "for": "10m",
      "annotations": {
        "description": "Primary node: {{ $labels.redis_hostname }}\nShard: {{ $labels.redis_instance }}\nEnv: {{ $labels.env }} | Site: {{ $labels.site_name }}\n\nConnected replicas: {{ $values.A.Value }}\nExpected: 4\n\nImpact: One or more replicas have disconnected from the primary. Reduced redundancy and read capacity; a subsequent primary failure has fewer promotion candidates. Check the disconnected replica nodes and network between them.",
        "summary": "Redis primary {{ $labels.redis_hostname }} has only {{ $values.A.Value }} replicas connected (expected 4)"
      },
      "labels": {
        "ALERT_ON_SITE": "true",
        "env": "__ENVIRONMENT__",
        "og_priority": "P2",
        "product": "zodiac",
        "ruleGroup": "__SITE_NAME__-Redis-Alerts",
        "service": "redis",
        "severity": "warning",
        "site_name": "__SITE_NAME__"
      },
      "isPaused": false,
      "ruleGroup": [[ group.name | tojson ]],
      "folderUID": [[ grafana.folder_uid | tojson ]],
      "orgId": [[ grafana.org_id ]]
    },
