      "annotations": {
        "description": "Instance: {{ $labels.redis_instance }} on {{ $labels.redis_hostname }}\nCommand: {{ $labels.cmd }}\nEnv: {{ $labels.env }} | Site: {{ $labels.site_name }}\n\np99 latency: {{ $values.A.Value }} s\nThreshold: > 0.05 s (baseline peak ~0.005 s)\n\nImpact: A Redis command is running an order of magnitude slower than normal. Check for slow commands (KEYS, large SCAN), CPU saturation, or memory pressure on this node.",
        "summary": "Redis high p99 latency on {{ $labels.redis_instance }} cmd={{ $labels.cmd }} ({{ $values.A.Value }}s)"
      },
      "labels": {
        "env": "__ENVIRONMENT__",
        "og_priority": "P3",
        "product": "zodiac",
        "ruleGroup": "__SITE_NAME__-Redis-Alerts",
        "service": "redis",
