        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": [[ grafana.datasources.prometheus | tojson ]],
          "model": {
            "editorMode": "code",
            "expr": "sum by(site_name,env,job,http_route)(\r\n  rate(http_server_request_duration_seconds_count{\r\n    env=\"__ENVIRONMENT__\",\r\n    site_name=\"__SITE_NAME__\",\r\n    job=~\"timer-event.*\",\r\n    http_response_status_code=~\"5..\",\r\n    http_route=~\"/get|/get/.*|/create|/update|/delete|/actuator/health\"\r\n  }[5m])\r\n)",
            "hide": false,
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0.5
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
