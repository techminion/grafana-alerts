    {
      "uid": "cfd3mv09bcnb4f",
      "title": "[__SITE_NAME__][__ENVIRONMENT__] Fluent-Bit-PipelineStuck",
      "condition": "A",
      "data": [
        {
          "refId": "INPUT_RATE",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": [[ grafana.datasources.prometheus | tojson ]],
          "model": {
            "disableTextWrap": false,
            "editorMode": "code",
            "expr": "(\nsum by(service_name, host_name) (\n  rate(fluentbit_input_records_total{\n    service_name=~\"fluent-bit-agent|fluent-bit-server\",\n    site_name=\"__SITE_NAME__\",\n    env=\"__ENVIRONMENT__\"\n  }[10m])\n)\n) OR on() vector(0)",
            "fullMetaSearch": false,
            "includeNullMetadata": true,
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "INPUT_RATE",
            "useBackend": false
          }
        },
        {
          "refId": "OUTPUT_RATE",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": [[ grafana.datasources.prometheus | tojson ]],
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": [[ grafana.datasources.prometheus | tojson ]]
            },
            "disableTextWrap": false,
            "editorMode": "code",
            "expr": "(\nsum by(service_name, host_name) (\n  rate(fluentbit_output_proc_records_total{\n    service_name=~\"fluent-bit-agent|fluent-bit-server\",\n    site_name=\"__SITE_NAME__\",\n    env=\"__ENVIRONMENT__\"\n  }[10m])\n)\n) OR on() vector(0)",
            "fullMetaSearch": false,
            "includeNullMetadata": true,
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "OUTPUT_RATE",
            "useBackend": false
          }
        },
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0,
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": []
                },
                "reducer": {
                  "params": [],
                  "type": "avg"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "name": "Expression",
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "$INPUT_RATE > 10 && ($OUTPUT_RATE / $INPUT_RATE) < 0.1",
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "A",
            "type": "math"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "10m",
      "annotations": {
        "description": "Fluent Bit is receiving log records but is not successfully processing or forwarding them.\n\nImpact:\nThe logging pipeline appears stalled. Logs may be buffered internally and risk being dropped if the condition persists.",
        "summary": "Fluent Bit pipeline is stalled with input activity but no output."
      },
      "labels": {
        "ALERT_ON_SITE": "true",
        "env": "__ENVIRONMENT__",
        "og_priority": "P2",
        "ruleGroup": "Fluent-Bit-Alerts",
