{
  "title": [[ group.name | tojson ]],
  "folderUid": [[ grafana.folder_uid | tojson ]],
  "interval": 60,
  "rules": [
    {
      "uid": "afd3j2l6om1a8d",
      "title": "[__SITE_NAME__][__ENVIRONMENT__] Node-Fluent-Bit-Down",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": [[ grafana.datasources.prometheus | tojson ]],
          "model": {
            "editorMode": "code",
            "expr": "(\n  max by (host_name, service_name) (\n    max_over_time(\n      fluentbit_uptime_total{\n        service_name=~\"fluent-bit-agent|fluent-bit-server\",\n        site_name=\"__SITE_NAME__\",\n        env=\"__ENVIRONMENT__\"\n      }[1h]\n    )\n  )\n  unless\n  on(host_name, service_name)\n  present_over_time(\n    fluentbit_uptime_total{\n      service_name=~\"fluent-bit-agent|fluent-bit-server\",\n      site_name=\"__SITE_NAME__\",\n      env=\"__ENVIRONMENT__\"\n    }[2m]\n  )\n)\nOR on() vector(0)",
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "A"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "5m",
      "annotations": {
        "summary": "A Fluent Bit agent or server on a specific host has stopped reporting uptime metrics for several minutes. Log collection from that node is unavailable. NOTE: if many hosts fire at once, suspect an ingestion-path issue and check [__SITE_NAME__][__ENVIRONMENT__] Fluent-Bit-Ingestion-Degraded before treating as per-node failures."
      },
      "labels": {
        "env": "__ENVIRONMENT__",
        "og_priority": "P2",
        "ruleGroup": "Fluent-Bit-Alerts",
        "scope": "node",
        "service": "fluentbit",
        "site_name": "__SITE_NAME__"
      },
      "isPaused": false,
      "ruleGroup": [[ group.name | tojson ]],
      "folderUID": [[ grafana.folder_uid | tojson ]],
      "orgId": [[ grafana.org_id ]]
    },
    {
      "uid": "bfd3l47f7b7y8a",
