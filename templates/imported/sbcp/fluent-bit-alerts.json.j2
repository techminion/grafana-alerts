      "noDataState": "OK",
      "execErrState": "Error",
      "for": "10m",
      "annotations": {
        "description": "Fluent Bit has started dropping log records while attempting to deliver them to the output backend.\n\nImpact:\nConfirmed log data loss. Some application and system logs may not be delivered to the logging backend.",
        "summary": "Fluent Bit is dropping log records at the output stage"
      },
      "labels": {
        "ALERT_ON_SITE": "true",
        "env": "__ENVIRONMENT__",
        "og_priority": "P3",
        "ruleGroup": "Fluent-Bit-Alerts",
