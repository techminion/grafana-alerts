    {
      "uid": "efpifv4a11vr4d",
      "title": "[__SITE_NAME__][__ENVIRONMENT__]OTEL Metric Missing - Redis (redis_commands_processed_total)",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": [[ grafana.datasources.prometheus | tojson ]],
          "model": {
            "expr": "absent_over_time(redis_commands_processed_total{site_name=\"__SITE_NAME__\"}[5m])",
            "hide": false,
            "instant": true,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Alerting",
      "for": "5m",
      "annotations": {
        "description": "The named metric redis_commands_processed_total{site_name=__SITE_NAME__} has produced no samples for >5m, while the Redis receiver may still be reporting other series. This catches a single metric being silently dropped (relabel rule, schema change, or per-metric scrape failure) — a case the receiver-level 'stopped scraping' rule won't catch. Verify the Redis receiver config and recent collector/pipeline changes.",
        "summary": "Metric redis_commands_processed_total has disappeared at __SITE_NAME__"
      },
      "labels": {
        "category": "otel-metric-absent",
        "env": "__ENVIRONMENT__",
        "product": "zodiac",
        "ruleGroup": "otel-collector-health",
        "severity": "critical",
        "site": "__SITE_NAME__",
        "site_name": "__SITE_NAME__",
        "source": "redis"
      },
      "isPaused": false,
      "ruleGroup": [[ group.name | tojson ]],
      "folderUID": [[ grafana.folder_uid | tojson ]],
      "orgId": [[ grafana.org_id ]]
    },
